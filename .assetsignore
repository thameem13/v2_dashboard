# wrangler.jsonc serves the repo ROOT as the static site ("assets.directory":
# "."), so anything sitting here at build time is uploaded and published.
#
# That was harmless until package.json arrived: Cloudflare's build then runs
# npm install, which creates node_modules/ inside the directory being
# uploaded. The supabase dev-dependency carries a large platform binary, and
# the asset upload blows past the file-count and size limits - so the deploy
# fails and the site silently keeps serving the previous version.
#
# .gitignore cannot cover this. The build container creates node_modules/
# itself, long after git is done.
node_modules/
package.json
package-lock.json

# Local tooling state, not part of the site.
.wrangler/
supabase/

# Claude Code project skill. Reference material for working ON the dashboard,
# not part of it - and .claude/skills/dashflow/references/security.md walks
# through this project's own security posture, which has no business being
# served from the dashboard's origin even behind Access.
.claude/

# Internal notes. They are in a public repo, but there is still no reason to
# serve them from the dashboard's own origin.
RELEASE.md
FEASIBILITY_REVIEW.md
VOLUME_REGIME.md
SECURITY.md

# Deleted 2026-10-29: it carried a live Supabase publishable key, and this
# repo is public. Kept listed as a guard, so if anyone ever restores the file
# for reference it still cannot be served from the live site.
index_old_main.html

# Database source. These run against Supabase via the CLI; they are not part
# of the site, and the detector's SQL names the tables and columns the browser
# is deliberately never told about.
sql/
