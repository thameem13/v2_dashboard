{
  // Cloudflare reads this on each Git deploy. "main" is what makes this a real
  // Worker rather than a static-assets-only project, which is what lets the
  // /api/rpc proxy run at all.
  "name": "v2-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  // Serve the repo root as the static site. Requests matching a real file
  // (index.html, etc.) are served directly; anything else falls through to
  // worker.js, which is how /api/rpc/* reaches the proxy.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // Plaintext vars belong here because Git-deployed Workers treat this file as
  // the source of truth - the dashboard greys out binding edits to avoid the
  // two disagreeing. This URL is not a secret; it is already in index.html.
  "vars": {
    "SUPABASE_URL": "https://egsgycizhssexstjrsqi.supabase.co"
  },

  // Telegram alerting. Every minute on weekdays, roughly 09:30-17:00 ET with
  // enough margin either side to cover both EDT and EST without changing this
  // twice a year. Not 24/7: there is nothing to alert on out of hours, and it
  // keeps the KV read count negligible.
  // TEMPORARY - every minute, to verify alerting outside market hours.
  // Revert to ["*/1 13-21 * * 1-5"] once a test message has arrived.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },

  // Holds lastAlertedCandle so a cron that re-reads the same candle does not
  // re-send. Declared here rather than bound in the dashboard because a
  // Git-deployed Worker treats this file as the source of truth - a binding
  // added through the UI would be dropped by the next push.
  //
  // A namespace id is an identifier, not a credential: reading or writing it
  // still requires account auth, which is why Cloudflare's own docs commit
  // these to public repos.
  "kv_namespaces": [
    { "binding": "ALERTS", "id": "b083f6cb5db34bebaafeaa0f4ee82a04" }
  ]

  // NOT here, deliberately: SUPABASE_SECRET_KEY, TELEGRAM_BOT_TOKEN and
  // TELEGRAM_CHAT_ID are secrets and never go in the repo. Add them as Secrets
  // in the dashboard; they survive deploys, plain Variables do not.
}
